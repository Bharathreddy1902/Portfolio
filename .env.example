# Public URL of the deployed site (used for SEO metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional: enables server-side email delivery from the contact form via Resend (https://resend.com).
# Without these, the form falls back to opening the visitor's email client with a pre-filled message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=craja62002@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
